# ===============================================================
# Agent Portfolio 專屬 .env 範本
# ---------------------------------------------------------------
# 使用方式：
#   1. 把整個 _template 資料夾複製一份，改名為你的策略名
#      例：etoro_trading/agents/future_world/
#   2. 把檔案名從 .env.example 改成 .env
#   3. 把建立 Agent Portfolio 時拿到的公鑰/私鑰填到下方
#   4. 絕對不要把 .env 加入 Git 或貼給任何人
#
# 安全提醒：
#   - 私鑰秘文只在 API 建立當下出現一次，沒存到就要砍重發
#   - 若你不小心外洩，立刻執行 SOP-4 熔斷（見 docs/API金鑰管理.md）
# ===============================================================

# --- 認證（打 API 時會放進 HTTP headers）---
AGENT_API_KEY=<公鑰 - 會放進 x-api-key header>
AGENT_USER_KEY=<私鑰 - 會放進 x-user-key header>

# --- Agent Portfolio metadata ---
# 若不知道，可以之後用主帳戶 key 打 GET /api/v1/agent-portfolios 查回來
AGENT_PORTFOLIO_ID=<agentPortfolioId，uuid 格式，若不知先留空>
AGENT_USER_TOKEN_ID=<userTokenId，uuid 格式，若不知先留空>
AGENT_MIRROR_ID=<mirrorId，整數，若不知先留空>

# --- 策略識別 ---
AGENT_NAME=<策略名稱，6~10 字元，對應 agentPortfolioName>
AGENT_SCOPE=203
# 203 = demo write（Phase 0 一律用這個）
# 202 = real write（通過 SOP-3 審核才可切換）

# --- 可選：鏡射比例（純紀錄用，不影響實際下單） ---
# investmentAmountInUsd / agentPortfolioVirtualBalance
AGENT_MIRROR_RATIO=0.05
