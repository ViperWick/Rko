# eToro API 設定（請勿將真實金鑰提交到版本控制）
# 複製此檔案為 .env 並填入您的金鑰

# ===== 主帳戶 Key =====
# 從 eToro 設定 > 交易 > API 金鑰管理 取得
# 這組金鑰用於：查詢主帳戶、建立/刪除 Agent Portfolio、管理 userToken
# 若您只有一個金鑰，可將 API_KEY 和 USER_KEY 設為相同值
ETORO_API_KEY=your_public_api_key
ETORO_USER_KEY=your_user_key

# 模式：demo（模擬）或 real（真實）
ETORO_MODE=demo

# ===== Agent Portfolio 相關 =====
# 每個 Agent Portfolio 的 userToken 不放這裡，放在：
#   etoro_trading/agents/<策略名>/.env
# 建立新 Agent Portfolio 的完整流程與規範，請見：
#   etoro_trading/docs/API金鑰管理.md

# --- 可選：本機 Ollama 摘要「日常自動化」log ---
# 需先安裝 Ollama 並 ollama pull llama3.2（或改成你的模型名）
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# 若 log 很長可縮短送入模型的字數（預設 14000）
# OLLAMA_LOG_MAX_CHARS=14000
